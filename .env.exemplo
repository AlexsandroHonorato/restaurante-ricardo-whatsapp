# Copie este arquivo para .env e preencha. Nunca publique o .env (ele tem as suas chaves).

# ---- passo 2 · WhatsApp (developers.facebook.com > seu app > WhatsApp > API Setup / Configuration)
WHATSAPP_TOKEN=cole-aqui-o-token-de-acesso
WHATSAPP_PHONE_NUMBER_ID=cole-aqui-o-phone-number-id
# uma senha que VOCÊ inventa e digita igual no campo "Verify token" da Meta
WHATSAPP_VERIFY_TOKEN=invente-uma-senha-longa
# App settings > Basic > App secret (confere que quem chamou o webhook foi a Meta)
WHATSAPP_APP_SECRET=cole-aqui-o-app-secret

# ---- passo 3 · modelo (openrouter.ai > Keys)
OPENROUTER_API_KEY=sk-or-cole-aqui
# qualquer modelo com suporte a ferramentas (tools) em openrouter.ai/models
MODELO=google/gemini-3.8-flash

# ---- geral
FUSO=America/Sao_Paulo
PORTA=3000
# dias que o conversas.log guarda (telefones e mensagens de clientes); o mais antigo é apagado
LOG_RETENCAO_DIAS=30
# produção: 127.0.0.1 (só o proxy /webhook e a API local alcançam o bot); vazio = todas as interfaces
ESCUTAR_EM=
# caminhos opcionais dos dados do bot (produção usa shared/bot/ de cada empresa)
ARQ_NEGOCIO=
ARQ_MEMORIA=
ARQ_PEDIDOS=
ARQ_LOG=

# ---- empresa atendida por este bot (aparece nas mensagens e na comanda)
EMPRESA_NOME=Restaurante Família Ricardo
EMPRESA_TELEFONE=(12) 99750-0045
EMPRESA_TELEFONE_2=(12) 98146-4976

# ---- integração interna bot/API
API_BASE_URL=http://127.0.0.1:8080/api
# Obrigatória: sem ela /api/notificar recusa tudo. Mínimo de 32 caracteres e a MESMA no backend/.env.
NOTIFICACAO_TOKEN=
# No backend/.env: BOT_URL=http://127.0.0.1:3000
