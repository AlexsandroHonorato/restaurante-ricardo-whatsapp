# Copie para impressora/.env no computador da cozinha (veja docs/IMPRESSORA.md).
# Endereço da API da empresa, terminando em /api
API_URL=https://empresa.botclient.propoclient.com.br/api
# Mesmo valor de IMPRESSORA_TOKEN do .env da API (mínimo 32 caracteres)
IMPRESSORA_TOKEN=
# IP fixo da Bematech MP-4200 TH na rede do restaurante (aparece na autoimpressão da impressora)
IMPRESSORA_IP=192.168.0.50
IMPRESSORA_PORTA=9100
# 48 colunas na bobina de 80 mm (fonte normal)
IMPRESSORA_COLUNAS=48
# De quanto em quanto tempo procura pedidos novos
INTERVALO_SEGUNDOS=5
